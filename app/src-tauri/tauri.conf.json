{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameZip",
  "version": "0.1.0",
  "identifier": "io.github.saimadhav10.gamezip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameZip",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src \u0027self\u0027; connect-src ipc: http://ipc.localhost; img-src \u0027self\u0027 asset: http://asset.localhost data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "saimadhav10",
    "homepage": "https://github.com/saimadhav10/GameZip",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/saimadhav10/GameZip/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5OEU1RTkyQUZCODNENEMKUldSTVBiaXZrbDZPR1RFUVNzNzF0UlJzWjFSZEVOYmlVa01jSFVzTTl5WFFmcFh6eGJFbFJkTmgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
